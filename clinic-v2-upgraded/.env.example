# Port server (banyak platform PaaS akan override otomatis lewat env PORT)
PORT=3000

# Password login petugas klinik - GANTI sebelum deploy ke produksi!
STAFF_PASSWORD=klinik123

# Origin yang diizinkan mengakses API (gunakan domain spesifik di produksi,
# misalnya https://klinik-uir.onrender.com). Gunakan * hanya untuk development.
CORS_ORIGIN=*

# Folder untuk menyimpan file data persisten (db.json).
# Saat deploy ke platform dengan persistent disk/volume, arahkan ke path volume tersebut.
DATA_DIR=./data

NODE_ENV=production
